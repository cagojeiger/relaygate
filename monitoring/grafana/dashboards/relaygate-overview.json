      "targets": [
        {
          "expr": "sum(rate(relaygate_gateway_dial_requests_total{cluster=~\"$cluster\",namespace=~\"$namespace\",instance=~\"$gateway\"}[$__rate_interval]))",
          "legendFormat": "request",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome, code) (rate(relaygate_gateway_dial_results_total{cluster=~\"$cluster\",namespace=~\"$namespace\",instance=~\"$gateway\"}[$__rate_interval]))",
