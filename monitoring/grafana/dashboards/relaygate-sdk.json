        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, instance, outcome) (rate(relaygate_sdk_reconnect_episode_duration_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\",instance=~\"$sdk\"}[$__rate_interval])))",
          "legendFormat": "{{instance}} {{outcome}}",
          "range": true,
          "refId": "A",
          "instant": false
        }
      ],
      "title": "재연결 종료시간 p95",
