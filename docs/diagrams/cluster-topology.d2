# 저장소 최상위 경로에서 렌더링:
# d2 --layout elk docs/diagrams/cluster-topology.d2 docs/diagrams/cluster-topology.svg
direction: right

classes: {
  actor: {shape: person; style.fill: "#f8fafc"; style.stroke: "#475569"; style.stroke-width: 2}
  gateway: {style.fill: "#eff6ff"; style.stroke: "#2563eb"; style.border-radius: 6}
  controller: {style.fill: "#ecfdf5"; style.stroke: "#059669"; style.border-radius: 6}
  store: {shape: cylinder; style.fill: "#ffffff"; style.stroke: "#059669"; style.stroke-width: 2}
  volatile: {shape: page; style.fill: "#f5f3ff"; style.stroke: "#7c3aed"}
  config: {shape: stored_data; style.fill: "#fff7ed"; style.stroke: "#ea580c"; style.stroke-width: 2}
  grpc: {style.stroke: "#2563eb"; style.stroke-width: 3}
  control: {style.stroke: "#7c3aed"; style.stroke-width: 2}
  raft: {style.stroke: "#059669"; style.stroke-width: 2}
  observe: {style.stroke: "#64748b"; style.stroke-width: 2}
  no: {style.stroke: "#dc2626"; style.stroke-dash: 5}
}

caller: {
  label: "호출자\nGo / Rust SDK"
  class: actor
}

listener: {
  label: "Listener\nGo / Rust SDK"
  class: actor
}

operator: {
  label: "운영자"
  class: actor
}

external_config: {
  label: "외부 클라이언트 설정\nClientId -> ApiKeyId 검증 값\n서비스 DB/Raft 인증 정보 없음"
  class: config
}

gateways: {
  label: "Gateway 역할 · 영속 저장소 없음"
  direction: down
  style.fill: "#f8fafc"
  style.stroke: "#2563eb"
  style.border-radius: 8

  ingress: {
    label: "진입 Gateway\n공개 Relay + Peer Relay\n제어 클라이언트\nRaft·저장소·제어 서버 없음"
    class: gateway
  }

  owner: {
    label: "소유 Gateway\nListener 바인딩\nPipe 구간 + payload 버퍼\n프로세스 메모리 전용"
    class: gateway
  }
}

controllers: {
  label: "Controller 역할 · 영속 제어 영역"
  direction: down
  style.fill: "#f0fdf4"
  style.stroke: "#059669"
  style.border-radius: 8

  leader: {
    label: "Controller A · 리더\n제어 gRPC + 관리 API\n공개·Peer Relay 없음"
    class: controller
  }

  followers: {
    label: ""
    direction: right
    style.fill: "#f0fdf4"
    style.stroke: "#f0fdf4"

    b: {
      label: "Controller B\nRaft 투표자"
      class: controller
    }

    c: {
      label: "Controller C\nRaft 투표자"
      class: controller
    }
  }

  durable: {
    label: "Controller별 영속 Raft 저장소\nterm / vote / log / 구성원\nstable state / snapshot / NodeId\n현재 GatewaySession + exact route"
    class: store
  }

  c_fsm: {
    label: "C · 합의된 현재 FSM\nGatewaySession + exact route\n실제 삭제 / 연쇄 삭제\n애플리케이션 tombstone·이력 없음"
    class: store
  }

  v_authority: {
    label: "V · 리더 로컬 권한 주체\nAuthorityId / 제어 세션\n소유 Relay 주소 / 재검증 거울\n리더 변경 시 초기화"
    class: volatile
  }
}

admission: {
  label: "새 Pipe 허용 판정\nA · L · Q · C · V · O\n111111만 허용"
  shape: diamond
  style.fill: "#ecfdf5"
  style.stroke: "#059669"
  style.stroke-width: 2
}

disaster: {
  label: "명시적 재해 초기화\n이전 경로를 먼저 차단\n새 epoch·집합은 빈 상태로 시작\nbootstrap은 구성원 복구가 아님"
  shape: page
  style.fill: "#fef2f2"
  style.stroke: "#dc2626"
  style.stroke-dash: 5
}

caller <-> gateways.ingress: "공개 Relay gRPC\nOpen / payload" {class: grpc}
gateways.owner <-> listener: "공개 Relay gRPC\nListen / Pipe" {class: grpc}
gateways.ingress <-> gateways.owner: "Peer Relay gRPC\n소유자 식별자별 공유 연결\n원격 Pipe별 독립 stream\n재연결·재생·재개 없음" {class: grpc}

external_config -> gateways.ingress: "시작 + SIGHUP\n프로세스 로컬 인증 snapshot" {class: control}
external_config -> gateways.owner: {class: control}

gateways.ingress -> controllers.leader: "Hello / 전체 snapshot\nDeclare / Withdraw" {class: control}
gateways.owner -> controllers.leader: "Hello로 소유 Relay 주소 광고\n현재 바인딩 전체 snapshot" {class: control}

controllers.leader <-> controllers.followers.b: "HashiCorp Raft TCP" {class: raft}
controllers.leader <-> controllers.followers.c: "HashiCorp Raft TCP" {class: raft}
controllers.leader -> controllers.durable: "log 영속화와 snapshot 압축" {class: raft}
controllers.followers.b -> controllers.durable: {class: raft}
controllers.followers.c -> controllers.durable: {class: raft}
controllers.durable -> controllers.c_fsm: "현재 행만 복원" {class: raft}
controllers.leader -> controllers.c_fsm: "선형화 가능한 C route 조회" {class: raft}
controllers.leader -> controllers.v_authority: "확인된 리더가 V 생성" {class: control}
controllers.leader -> admission: "L + Q\nVerifyLeader + Barrier" {class: raft}
controllers.v_authority -> admission: "V" {class: control}
controllers.c_fsm -> admission: "C" {class: raft}
gateways.ingress -> admission: "A" {class: control}
gateways.owner -> admission: "O · 소유자 예약" {class: control}

operator -> controllers.leader: "GET /status\n읽기 전용" {class: observe}
operator -> gateways.ingress: "GET /status\n읽기 전용" {class: observe}
operator -> disaster: "수동 작업만" {class: no}
disaster -> controllers.durable: "자동 복구 아님" {class: no}
