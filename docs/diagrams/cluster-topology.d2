# Render from the repository root:
# d2 --layout elk docs/diagrams/cluster-topology.d2 docs/diagrams/cluster-topology.svg
direction: right

classes: {
  actor: {shape: person; style.fill: "#f8fafc"; style.stroke: "#475569"; style.stroke-width: 2}
  gateway: {style.fill: "#eff6ff"; style.stroke: "#2563eb"; style.border-radius: 6}
  controller: {style.fill: "#ecfdf5"; style.stroke: "#059669"; style.border-radius: 6}
  store: {shape: cylinder; style.fill: "#ffffff"; style.stroke: "#059669"; style.stroke-width: 2}
  volatile: {shape: page; style.fill: "#f5f3ff"; style.stroke: "#7c3aed"}
  config: {shape: stored_data; style.fill: "#fff7ed"; style.stroke: "#ea580c"; style.stroke-width: 2}
  grpc: {style.stroke: "#2563eb"; style.stroke-width: 3}
  control: {style.stroke: "#7c3aed"; style.stroke-width: 2}
  raft: {style.stroke: "#059669"; style.stroke-width: 2}
  observe: {style.stroke: "#64748b"; style.stroke-width: 2}
  no: {style.stroke: "#dc2626"; style.stroke-dash: 5}
}

caller: {
  label: "Caller\nGo / Rust SDK"
  class: actor
}

listener: {
  label: "Listener\nGo / Rust SDK"
  class: actor
}

operator: {
  label: "Operator"
  class: actor
}

external_config: {
  label: "External client config\nClientId -> ApiKeyId verifier\nno service DB or Raft credential state"
  class: config
}

gateways: {
  label: "Gateway role · no durable store"
  direction: down
  style.fill: "#f8fafc"
  style.stroke: "#2563eb"
  style.border-radius: 8

  ingress: {
    label: "Ingress Gateway\npublic Relay + peer Relay\ncontrol client\nno Raft/store/control server"
    class: gateway
  }

  owner: {
    label: "Owner Gateway\nListener bindings\nPipe segments + payload buffers\nprocess memory only"
    class: gateway
  }
}

controllers: {
  label: "Controller role · durable control plane"
  direction: down
  style.fill: "#f0fdf4"
  style.stroke: "#059669"
  style.border-radius: 8

  leader: {
    label: "Controller A · leader\ncontrol gRPC + admin\nno public/peer Relay"
    class: controller
  }

  followers: {
    label: ""
    direction: right
    style.fill: "#f0fdf4"
    style.stroke: "#f0fdf4"

    b: {
      label: "Controller B\nRaft voter"
      class: controller
    }

    c: {
      label: "Controller C\nRaft voter"
      class: controller
    }
  }

  durable: {
    label: "Durable Raft store per controller\nterm / vote / log / membership\nstable state / snapshots / NodeId\ncurrent GatewaySession + exact routes"
    class: store
  }

  c_fsm: {
    label: "C · committed current FSM\nGatewaySession + exact routes\ntrue delete / cascade\nno application tombstone/history"
    class: store
  }

  v_authority: {
    label: "V · leader-local authority\nAuthorityId / control sessions\nowner relay addresses / revalidated mirror\nresets on leader change"
    class: volatile
  }
}

admission: {
  label: "New-Pipe admission\nA · L · Q · D · V · O\nonly 111111 admits"
  shape: diamond
  style.fill: "#ecfdf5"
  style.stroke: "#059669"
  style.stroke-width: 2
}

disaster: {
  label: "Explicit disaster reset\nfence old paths first\nnew epoch/cohort starts empty\nbootstrap is not member recovery"
  shape: page
  style.fill: "#fef2f2"
  style.stroke: "#dc2626"
  style.stroke-dash: 5
}

caller <-> gateways.ingress: "public Relay gRPC\nOpen / payload" {class: grpc}
gateways.owner <-> listener: "public Relay gRPC\nListen / Pipe" {class: grpc}
gateways.ingress <-> gateways.owner: "peer Relay gRPC\none stream per remote Pipe\nno redial/replay/resume" {class: grpc}

external_config -> gateways.ingress: "startup + SIGHUP\nprocess-local auth snapshot" {class: control}
external_config -> gateways.owner: {class: control}

gateways.ingress -> controllers.leader: "Hello / full snapshot\nDeclare / Withdraw" {class: control}
gateways.owner -> controllers.leader: "Hello advertises owner relay address\nfull current binding snapshot" {class: control}

controllers.leader <-> controllers.followers.b: "HashiCorp Raft TCP" {class: raft}
controllers.leader <-> controllers.followers.c: "HashiCorp Raft TCP" {class: raft}
controllers.leader -> controllers.durable: "persist and compact log to snapshots" {class: raft}
controllers.followers.b -> controllers.durable: {class: raft}
controllers.followers.c -> controllers.durable: {class: raft}
controllers.durable -> controllers.c_fsm: "restore current rows only" {class: raft}
controllers.leader -> controllers.c_fsm: "linearizable D route lookup" {class: raft}
controllers.leader -> controllers.v_authority: "confirmed leader creates V" {class: control}
controllers.leader -> admission: "L + Q\nVerifyLeader + Barrier" {class: raft}
controllers.v_authority -> admission: "V" {class: control}
controllers.c_fsm -> admission: "D" {class: raft}
gateways.ingress -> admission: "A" {class: control}
gateways.owner -> admission: "O owner reservation" {class: control}

operator -> controllers.leader: "GET /status\nread-only" {class: observe}
operator -> gateways.ingress: "GET /status\nread-only" {class: observe}
operator -> disaster: "manual only" {class: no}
disaster -> controllers.durable: "not automatic recovery" {class: no}
